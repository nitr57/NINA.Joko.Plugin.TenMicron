  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="!$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">
    <Exec Command="echo TargetDir: $(TargetDir)&#xD;&#xA;      if not exist &quot;%25localappdata%25\NINA\Plugins&quot; (&#xD;&#xA;      echo &quot;Creating $(PlatformName) Plugins folder&quot;&#xD;&#xA;      mkdir  &quot;%25localappdata%25\NINA\Plugins&quot;&#xD;&#xA;      mkdir  &quot;%25localappdata%25\NINA\Plugins\3.0.0&quot;&#xD;&#xA;      )&#xD;&#xA;&#xD;&#xA;      if not exist &quot;%25localappdata%25\NINA\Plugin\10 Micron Tools&quot; (&#xD;&#xA;      echo &quot;Creating $(PlatformName) Plugins 10 Micron Tools folder&quot;&#xD;&#xA;      mkdir  &quot;%25localappdata%25\NINA\Plugins\3.0.0\10 Micron Tools&quot;&#xD;&#xA;      )&#xD;&#xA;&#xD;&#xA;      echo &quot;Copying $(PlatformName) $(TargetFileName)&quot;&#xD;&#xA;      xcopy &quot;$(TargetPath)&quot; &quot;%25localappdata%25\NINA\Plugins\3.0.0\10 Micron Tools&quot; /h/k/r/y&#xD;&#xA;      xcopy &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;%25localappdata%25\NINA\Plugins\3.0.0\10 Micron Tools&quot; /h/k/r/y&#xD;&#xA;&#xD;&#xA;      echo &quot;Copying $(PlatformName) $(TargetFileName) Dependencies&quot;&#xD;&#xA;      xcopy &quot;$(TargetDir)Antlr4.Runtime.Standard.dll&quot; &quot;%25localappdata%25\NINA\Plugins\3.0.0\10 Micron Tools&quot; /h/k/r/y" />
  </Target>
  <Target Name="PostBuildLinux" AfterTargets="PostBuildEvent" Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">
    <Exec Command="mkdir -p $HOME/.local/share/NINA/Plugins/3.0.0/TenMicron" />
    <Exec Command="cp $(TargetPath) $HOME/.local/share/NINA/Plugins/3.0.0/TenMicron/" />
    <Exec Command="cp $(TargetDir)Antlr4BuildTasks.dll $HOME/.local/share/NINA/Plugins/3.0.0/TenMicron/" />
    <Exec Command="cp $(TargetDir)Antlr4.Runtime.Standard.dll $HOME/.local/share/NINA/Plugins/3.0.0/TenMicron/" />
